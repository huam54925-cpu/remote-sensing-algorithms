{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "no-gpu-1788868434",
    "namespace": "rs-gpu-tests"
  },
  "spec": {
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 10,
    "activeDeadlineSeconds": 240,
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true
    },
    "containers": [
      {
        "name": "compute",
        "image": "remote-sensing-framework:0.3.0-kmeans1",
        "imagePullPolicy": "Never",
        "command": [
          "python",
          "-u",
          "-c",
          "import os,json; assert not os.path.exists('/dev/nvidia0'); print(json.dumps({'status':'PASS','gpu_device_visible':False}))"
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "512Mi"
          }
        },
        "securityContext": {
          "readOnlyRootFilesystem": true,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "volumeMounts": [
          {
            "name": "test",
            "mountPath": "/test",
            "readOnly": true
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "test",
        "configMap": {
          "name": "gpu-compute-1788868434"
        }
      },
      {
        "name": "tmp",
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "64Mi"
        }
      }
    ]
  }
}