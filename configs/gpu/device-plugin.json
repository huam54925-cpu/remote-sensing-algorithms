{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "name": "nvidia-device-plugin",
    "namespace": "kube-system"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "nvidia-device-plugin"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "nvidia-device-plugin"
        }
      },
      "spec": {
        "nodeSelector": {
          "kubernetes.io/hostname": "rs-lab-control-plane"
        },
        "tolerations": [
          {
            "operator": "Exists"
          }
        ],
        "priorityClassName": "system-node-critical",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "plugin",
            "image": "nvcr.io/nvidia/k8s-device-plugin@sha256:1de09dda8d1c179fe84e280f28a48a75c9a1a529d90eefcee1f80c012ac11640",
            "imagePullPolicy": "Never",
            "env": [
              {
                "name": "DEVICE_LIST_STRATEGY",
                "value": "cdi-cri"
              },
              {
                "name": "FAIL_ON_INIT_ERROR",
                "value": "true"
              },
              {
                "name": "NVIDIA_VISIBLE_DEVICES",
                "value": "nvidia.com/gpu=all"
              },
              {
                "name": "CONTAINER_DRIVER_ROOT",
                "value": "/driver-root"
              },
              {
                "name": "NVIDIA_CDI_HOOK_PATH",
                "value": "/usr/bin/nvidia-cdi-hook"
              },
              {
                "name": "NVIDIA_DRIVER_ROOT",
                "value": "/opt/nvidia-driver"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "device-plugins",
                "mountPath": "/var/lib/kubelet/device-plugins"
              },
              {
                "name": "cdi-output",
                "mountPath": "/var/run/cdi"
              },
              {
                "name": "driver-root",
                "mountPath": "/driver-root",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "device-plugins",
            "hostPath": {
              "path": "/var/lib/kubelet/device-plugins",
              "type": "Directory"
            }
          },
          {
            "name": "cdi-output",
            "hostPath": {
              "path": "/var/run/cdi",
              "type": "DirectoryOrCreate"
            }
          },
          {
            "name": "driver-root",
            "hostPath": {
              "path": "/opt/nvidia-driver",
              "type": "Directory"
            }
          }
        ],
        "runtimeClassName": "nvidia-bootstrap"
      }
    }
  }
}
